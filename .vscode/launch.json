{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "🚀 Debug Discord Bot (Local TSX)",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["tsx", "watch", "src/index.ts"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "restart": true,
      "envFile": "${workspaceFolder}/.env",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "⚡ Deploy Slash Commands to Discord API",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["tsx", "src/deploy-commands.ts"],
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "type": "node",
      "request": "attach",
      "name": "🐳 Attach to Docker Container (Port 9229)",
      "port": 9229,
      "address": "localhost",
      "localRoot": "${workspaceFolder}/dist",
      "remoteRoot": "/app/dist",
      "restart": true
    }
  ]
}