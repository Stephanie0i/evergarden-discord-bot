# ========================================================
# DISCORD BOT CREDENTIALS
# Get these from https://discord.com/developers/applications
# ========================================================
DISCORD_TOKEN="bot token"
CLIENT_ID="your_application_client_id"
GUILD_ID="your_server_id"

# ========================================================
# BOT PRESENCE & ACTIVITY
# ========================================================
PRESENCE_STATUS="online"
ACTIVITY_TYPE="Custom"
ACTIVITY_TEXT="✉️ Writing letters for those who cannot"

# ========================================================
# 24/7 VOICE CHANNEL CONFIGURATION
# Voice channel ID where the bot remains connected permanently
# ========================================================
VOICE_CHANNEL_ID="your_voice_channel_id"
VOICE_SELF_DEAF="true"
VOICE_SELF_MUTE="false"
VOICE_RECONNECT_DELAY_MS="2000"

# ========================================================
# VERIFICATION & ONBOARDING SYSTEM
# ========================================================
VERIFICATION_CHANNEL_ID="your_verify_channel_id"
ADMIN_REVIEW_CHANNEL_ID="your_admin_review_channel_id"
WELCOME_CHANNEL_ID="your_welcome_channel_id"

# Roles automatically managed upon member onboarding & verification
VERIFIED_ROLE_ID="your_verified_role_id"
UNVERIFIED_ROLE_ID="your_unverified_role_id"

# Verification Portal Customization
VERIFICATION_PORTAL_TITLE="💌 Letter of Introduction"
VERIFICATION_PORTAL_DESC="Every guest of Evergarden is welcomed with a letter. Tell us a little about yourself, and our staff will read it and open the doors of the server for you."
VERIFICATION_BTN_LABEL="Write your letter"
VERIFICATION_BTN_EMOJI="✉️"

# Questionnaire Modal Questions
VERIFY_Q1_LABEL="What brings you to our community?"
VERIFY_Q1_PLACEHOLDER="Tell us about your interests, projects, or goals..."
VERIFY_Q2_LABEL="Do you agree to abide by all server rules?"
VERIFY_Q2_PLACEHOLDER="Type Yes, I agree"
VERIFY_Q3_LABEL="How did you find this server? (Optional)"
VERIFY_Q3_PLACEHOLDER="Friend invite, GitHub, Twitter, etc."

# Automated DM on Approval
AUTO_DM_ON_APPROVAL="true"
DM_APPROVAL_MESSAGE="🎉 Congratulations! You have been approved by server staff. You now have full access to all channels and voice lounges."

# Rich Welcome Embed Customization
WELCOME_GIF_URL="https://media.giphy.com/media/v1.Y2lkPTc5MGI3NjExbnEwNHpxdzd6cHBkcmZocGpxbTllMWsydnB2OWtrb2RjMXR0cWdycyZlcD12MV9naWZzX3NlYXJjaCZjdD1n/mDFpdL1UxdVFa/giphy.gif"
WELCOME_TITLE="Welcome to the Community!"
WELCOME_DESCRIPTION="We are thrilled to have you here. You have completed identity verification and now have full access to our channels and voice lounges."
WELCOME_EMBED_COLOR="#5865F2"
WELCOME_SHOW_MEMBER_COUNT="true"

# ========================================================
# AUTOMOD & MODERATION AUDIT LOGGING
# ========================================================
MOD_LOG_CHANNEL_ID="your_mod_log_channel_id"
ENABLE_ANTI_INVITE="true"
BLOCKED_KEYWORDS="discord.gg/,telegram.me/,t.me/,free nitro,crypto gift"
ENABLE_SPAM_DETECTION="true"
STAFF_NOTIFICATION_ROLE="Moderator"

# ========================================================
# FLY.IO HEALTHCHECK PORT & ROUTE
# ========================================================
PORT="8080"
HEALTH_CHECK_ENDPOINT="/healthz"