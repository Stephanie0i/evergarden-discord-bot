{
  "name": "evergarden-discord-bot",
  "version": "1.0.0",
  "description": "A beautiful, free-to-run Discord bot inspired by Auto Memory Dolls. 24/7 voice persistence, elegant verification, moderation, and themed embeds — under 50MB RAM on Fly.io free tier.",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "deploy:commands": "tsx src/deploy-commands.ts",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "discord",
    "discord-bot",
    "discord.js",
    "typescript",
    "fly.io",
    "verification",
    "moderation",
    "voice",
    "evergarden",
    "free-hosting"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/YOUR_USERNAME/evergarden-discord-bot.git"
  },
  "bugs": {
    "url": "https://github.com/YOUR_USERNAME/evergarden-discord-bot/issues"
  },
  "homepage": "https://github.com/YOUR_USERNAME/evergarden-discord-bot#readme",
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5",
    "opusscript": "^0.0.8",
    "prism-media": "^1.3.5"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
